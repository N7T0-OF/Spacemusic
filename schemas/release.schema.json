{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N7T0-OF/Spacemusic/main/schemas/release.schema.json",
  "title": "SpaceMusic module release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "moduleId",
    "version",
    "status",
    "compatibility",
    "artifact",
    "sha256",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "artifact": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "type": "string",
            "pattern": "^https://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "artifact": {
            "type": "null"
          },
          "sha256": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minConvxVersion",
        "maxConvxVersion"
      ],
      "properties": {
        "minConvxVersion": {
          "$ref": "#/$defs/semver"
        },
        "maxConvxVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
