{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N7T0-OF/Spacemusic/main/schemas/manifest.schema.json",
  "title": "SpaceMusic module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "version",
    "type",
    "description",
    "author",
    "compatibility",
    "permissions",
    "content",
    "updates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "type": {
      "const": "declarative"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "settings"
        ]
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "icon"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/packagePath"
        },
        "icon": {
          "$ref": "#/$defs/packagePath"
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseIndex"
      ],
      "properties": {
        "releaseIndex": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minConvxVersion",
        "maxConvxVersion"
      ],
      "properties": {
        "minConvxVersion": {
          "$ref": "#/$defs/semver"
        },
        "maxConvxVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!/)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
